# Copy to apps/web/.env.local and fill in.

# Which chat provider the API route uses: "openrouter" (default) or "echo"
# (repeats your message back; needs no key). Registered providers live in
# packages/core/src/providers/index.ts.
CHAT_PROVIDER=openrouter

# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models (default: DeepSeek V4.1 Flash).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Embedding model for searching the documents in apps/web/knowledge/
# (default: BAAI BGE-M3, multilingual).
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
